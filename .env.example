# localopenbrainobsidian — environment overrides
#
# You normally DON'T need this file: configuration is managed through the app's
# settings (~/.localopenbrain/settings.json, written by the frontend setup
# flow). Env vars here OVERRIDE settings — useful for CI or power users.

# --- Supabase (documents + RAG + memory) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Models (OpenAI-compatible; defaults to local Ollama) ---
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_API_KEY=
# EMBED_MODEL=nomic-embed-text
# EMBED_DIM=768
# CHAT_MODEL=llama3.1:8b

# --- Obsidian vault ---
# VAULT_ROOT=/absolute/path/to/your/vault

# --- MCP server ---
# MCP_ACCESS_KEY=        # auto-generated on first run if unset
# MCP_PORT=8787
# MCP_HOST=127.0.0.1

# --- Settings file location (defaults to ~/.localopenbrain/settings.json) ---
# LOB_SETTINGS_PATH=
